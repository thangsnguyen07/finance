# ==============================================================================
# FINANCE MONOREPO ENVIRONMENT VARIABLES
# ==============================================================================
# In production, all secrets are managed via Infisical (https://app.infisical.com)
# under project "finance" with scopes:
#   - /backend  (synced to Render)
#   - /frontend (synced to Vercel)
#
# For local dev without .env files, install Infisical CLI and run:
#   infisical run --path=/backend -- pnpm dev:backend
#   infisical run --path=/frontend -- pnpm dev:frontend
# Or populate local .env files based on this template.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local PostgreSQL Docker container (defaults from docker-compose.yml):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_db
POSTGRES_PORT=5432

# Connection String:
# Local: postgresql://postgres:postgres@localhost:5432/finance_db
# Supabase Production (Singapore pooler):
#   postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db

# SSL toggle: Set to 'true' for Supabase / Cloud PostgreSQL, 'false' for local docker
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 2. BACKEND (NestJS / Render) - Infisical Scope: /backend
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Dev:  http://localhost:3000
# Prod: https://finance-app.vercel.app
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. FRONTEND (Next.js / Vercel) - Infisical Scope: /frontend
# ------------------------------------------------------------------------------
# Base API URL used by Next.js Server to contact NestJS Backend
# Private server-side variable (completely hidden from browser DevTools):
# Dev:  http://localhost:4000
# Prod: https://<your-render-service>.onrender.com
BACKEND_API_URL=http://localhost:4000

# Clerk Authentication (Placeholder for Phase 2 Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
