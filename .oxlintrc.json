{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "import"],
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "off"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "**/dist/**"]
}
