{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["@/"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "type",
      "style",
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./frontend/src/app/globals.css",
    "functions": ["cn", "clsx"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "pnpm-lock.yaml",
    ".agents/**",
    ".claude/**"
  ]
}
